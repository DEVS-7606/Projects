# Frontend - Vite env vars (must start with VITE_)
# Local: http://localhost:3002/api
# Vercel: /api  (relative, no domain needed since frontend and backend are on same domain)
VITE_API_BASE_URL=/api

# Backend
PORT=3002
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
JWT_SECRET=your_jwt_secret
# Vercel: set this to your Vercel deployment URL e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
